  "info": {
    "title": "eSocial IRRF Revenue Codes API (TOTVS RH / TAF Social)",
    "description": "Especificação OpenAPI / Swagger dos contratos de API para consulta e conferência de códigos de receita do eSocial IRRF. \n\n**Atualização (RF01, RF02, RF03)**: O contrato foi atualizado para suportar o processamento de intervalos de datas (`period` e `periodEnd`) nos formatos AAAA, AAAA/MM, MM/AAAA, MMAAAA ou YYYYMM, preparando a arquitetura para o consumo via TAFFULL.",
    "version": "1.200",
    "x-totvs": {
      "messageDocumentation": {
        "name": "ReportEsocialIrrfRevenueCodes",
        "description": "Relatório de Códigos de Receita do eSocial IRRF",
        "segment": "RH"
      },
      "productInformation": [
        {
          "product": "TAF",
          "contact": "comiteintegracao@totvs.com.br",
          "description": "Códigos de Receita eSocial"
        }
      ]
    }
  },
  "definitions": {
    "ExecuteReportEsocialIrrfRevenueCodesRequest": {
      "type": "object",
      "required": [
        "companyId",
        "period",
        "periodEnd"
      ],
      "properties": {
        "companyId": {
          "type": "string"
        },
        "period": {
          "type": "string",
          "description": "Competência Inicial no formato AAAA, AAAA/MM, MM/AAAA, MMAAAA ou YYYYMM",
          "pattern": "^((19|20)\\d{2}|(19|20)\\d{2}/?(0[1-9]|1[0-2])|(0[1-9]|1[0-2])/?(19|20)\\d{2})$",
          "example": "01/2025"
        },
        "periodEnd": {
          "type": "string",
          "description": "Competência Final no formato AAAA, AAAA/MM, MM/AAAA, MMAAAA ou YYYYMM",
          "pattern": "^((19|20)\\d{2}|(19|20)\\d{2}/?(0[1-9]|1[0-2])|(0[1-9]|1[0-2])/?(19|20)\\d{2})$",
          "example": "12/2025"
        },
        "tribute": {
          "type": "string",
          "default": "4"
        },
        "differencesOnly": {
          "type": "boolean"
        },
        "cpf": {
          "type": "string"
        },
        "revenueCode": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "valueOption": {
          "type": "string"
        },
        "requestId": {
          "type": "string"
        }
      }
    },
