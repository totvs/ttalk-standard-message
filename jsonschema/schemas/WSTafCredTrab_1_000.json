  "definitions": {
    "CredTrabResponse": {
      "type": "object",
      "properties": {
        "Ambiente": {
          "type": "string",
          "description": "Ambiente consultado"
        },
        "Arquivo": {
          "type": "string",
          "description": "Arquivo de retorno do TSS (geralmente XML codificado em Base64)"
        },
        "CodRequisicao": {
          "type": "string",
          "description": "Código da requisição no TSS"
        },
        "Competencia": {
          "type": "string",
          "description": "Competência consultada"
        },
        "DescrErro": {
          "type": "string",
          "description": "Descrição de erro, se houver"
        },
        "HrSolicitacao": {
          "type": "string",
          "description": "Hora da solicitação no TSS"
        },
        "Id": {
          "type": "string",
          "description": "ID interno de retorno"
        },
        "Id_ent": {
          "type": "string",
          "description": "Entidade do TSS"
        },
        "Status": {
          "type": "string",
          "description": "Status do processamento da consulta"
        },
        "DtSolicitacao": {
          "type": "string",
          "description": "Data da solicitação no formato AAAAMMDD"
        },
        "TipoTSS": {
          "type": "string",
          "description": "Tipo de operação: 1 (Mensal), 2 (Extrato)"
        },
        "CPF": {
          "type": "string",
          "description": "CPF consultado (apenas para extrato)"
        }
      }
    }
