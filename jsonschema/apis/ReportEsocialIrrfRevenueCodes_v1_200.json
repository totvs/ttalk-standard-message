  "components": {
    "parameters": {
      "queryCompanyId": {
        "name": "companyId",
        "in": "query",
        "required": true,
        "description": "Código identificador de Empresa/Filial",
        "schema": {
          "type": "string",
          "example": "T1|D MG 01"
        }
      },
      "queryperiod": {
        "name": "period",
        "in": "query",
        "required": true,
        "description": "Competência Inicial no formato AAAA, AAAA/MM, MM/AAAA, MMAAAA ou YYYYMM",
        "schema": {
          "type": "string",
          "pattern": "^((19|20)\\d{2}|(19|20)\\d{2}/?(0[1-9]|1[0-2])|(0[1-9]|1[0-2])/?(19|20)\\d{2})$",
          "example": "01/2025"
        }
      },
      "queryperiodEnd": {
        "name": "periodEnd",
        "in": "query",
        "required": true,
        "description": "Competência Final no formato AAAA, AAAA/MM, MM/AAAA, MMAAAA ou YYYYMM",
        "schema": {
          "type": "string",
          "pattern": "^((19|20)\\d{2}|(19|20)\\d{2}/?(0[1-9]|1[0-2])|(0[1-9]|1[0-2])/?(19|20)\\d{2})$",
          "example": "12/2025"
        }
      },
      "queryTribute": {
        "name": "tribute",
        "in": "query",
        "required": false,
        "description": "Identificador do Tributo (Fixo '4' para IRRF)",
        "schema": {
          "type": "string",
          "default": "4",
          "example": "4"
        }
      },
      "queryDifferencesOnly": {
        "name": "differencesOnly",
        "in": "query",
        "required": false,
        "description": "Filtrar apenas diferenças/divergências",
        "schema": {
          "type": "boolean",
          "default": false
        }
      },
      "queryCpf": {
        "name": "cpf",
        "in": "query",
        "required": false,
        "description": "Filtro por CPF do trabalhador",
        "schema": {
          "type": "string",
          "example": "12345678901"
        }
      },
      "queryRevenueCode": {
        "name": "revenueCode",
        "in": "query",
        "required": false,
        "description": "Filtro por Código de Receita",
        "schema": {
          "type": "string",
          "example": "0561"
        }
      },
      "queryName": {
        "name": "name",
        "in": "query",
        "required": false,
        "description": "Filtro por Nome do trabalhador",
        "schema": {
          "type": "string",
          "example": "João da Silva"
        }
      },
      "queryValueOption": {
        "name": "valueOption",
        "in": "query",
        "required": false,
        "description": "Origem da conferência (Gov, Fol, Taf)",
        "schema": {
          "type": "string",
          "enum": ["Gov", "Fol", "Taf"],
          "default": "Gov"
        }
      },
      "queryRequestId": {
        "name": "requestId",
        "in": "query",
        "required": false,
        "description": "ID da requisição",
        "schema": {
          "type": "string"
        }
      },
      "queryPage": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "Página (paginação)",
        "schema": {
          "type": "integer"
        }
      },
      "queryPageSize": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "description": "Tamanho da página",
        "schema": {
          "type": "integer"
        }
      }
    },
    "schemas": {}
  }
