    "/api/rh/esocial/v1/reportEsocialIrrfRevenueCodes": {
      "post": {
        "tags": ["Padrão"],
        "summary": "Executar Relatório de Códigos de Receita do eSocial IRRF",
        "description": "Inicia o processamento do relatório. A API (middleware) valida cronologicamente `period` e `periodEnd`. Falha rápido (400 Bad Request) se o final for menor que o inicial.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "https://raw.githubusercontent.com/totvs/ttalk-standard-message/master/jsonschema/schemas/ReportEsocialIrrfRevenueCodes_1_200.json#/definitions/ExecuteReportEsocialIrrfRevenueCodesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://raw.githubusercontent.com/totvs/ttalk-standard-message/master/jsonschema/schemas/ReportEsocialIrrfRevenueCodes_1_200.json#/definitions/ExecuteReportEsocialBaseConferResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Validação cronológica falhou (ex: data final menor que a inicial)."
          }
        }
      }
    },
