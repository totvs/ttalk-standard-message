                    }
                  },
                  "erroImpeditivo": {
                    "summary": "Erro impeditivo - evento rejeitado, sem recibo",
                    "description": "A ocorrência de tipo 1 impede a autorização. O nó 'streamingErrors' traz o motivo da rejeição e 'receiptNumber' vem vazio.",
                    "value": {
                      "type": "ticketCode",
                      "code": "000000000002",
                      "items": [
                        {
                          "success": true,
