                },
                "examples": {
                  "sucessoTotal": {
                    "summary": "Sucesso total - evento autorizado, sem ocorrências",
                    "description": "O evento foi aceito pelo governo. Os nós 'streamingErrors' e 'warnings' vêm vazios e 'receiptNumber' traz o recibo.",
                    "value": {
                      "type": "ticketCode",
                      "code": "000000000001",
                      "items": [
                        {
                          "success": true,
